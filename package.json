{
  "name": "@opum-ai/quest",
  "version": "0.13.0",
  "description": "Deterministic, LLM-free task tracker CLI — the record layer coding agents and humans write to.",
  "license": "MIT",
  "author": "Opum AI",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://questgraph.dev",
  "bugs": {
    "url": "https://github.com/opum-ai/quest-cli/issues"
  },
  "keywords": [
    "cli",
    "task-tracker",
    "project-management",
    "issue-tracking",
    "ai-agents",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/quest-cli.git"
  },
  "bin": {
    "quest": "./bin/quest.cjs"
  },
  "files": [
    "bin/quest.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts hooks types tests biome.json package.json tsconfig.json",
    "format": "biome format --write src test scripts hooks types tests biome.json package.json tsconfig.json",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src test scripts hooks types tests biome.json package.json tsconfig.json",
    "layer:check": "node scripts/check-layers.mjs",
    "build:packages": "\"$npm_execpath\" run scripts/build-platform-packages.mjs",
    "check:packages": "\"$npm_execpath\" run scripts/check-package-artifacts.mjs",
    "check:lockfile": "node scripts/check-lockfile-pins.mjs",
    "check:breaking-bump": "node scripts/check-breaking-bump.mjs",
    "check:breaking-bump:pair": "node scripts/check-breaking-bump.mjs --pair",
    "test:packages": "QUEST_AGENT_PLUGINS=off \"$npm_execpath\" run scripts/test-packed-packages.mjs",
    "qualify:migration-artifact": "\"$npm_execpath\" run scripts/qualification/migration-lifecycle.mjs",
    "deliver:packages": "\"$npm_execpath\" run scripts/deliver-package-artifacts.mjs",
    "install:platform-candidates": "node scripts/install-platform-candidates.mjs",
    "test:package-artifact-delivery": "\"$npm_execpath\" run scripts/test-package-artifact-delivery.mjs",
    "test:repository-check-scope": "node scripts/test-repository-check-scope.mjs",
    "test:mod": "node scripts/mod-test.mjs",
    "test": "\"$npm_execpath\" run test:repository-check-scope && \"$npm_execpath\" run test:package-artifact-delivery && QUEST_AGENT_PLUGINS=off \"$npm_execpath\" test --path-ignore-patterns='tests/**'",
    "check": "\"$npm_execpath\" run typecheck && \"$npm_execpath\" run lint && \"$npm_execpath\" run format:check && \"$npm_execpath\" run layer:check && \"$npm_execpath\" run test && \"$npm_execpath\" run test:mod",
    "receipt:emit": "node scripts/qualification/native-execution-receipt.mjs",
    "receipt:require": "node scripts/qualification/native-execution-receipt.mjs --require",
    "receipt:verify-published": "node scripts/qualification/native-execution-receipt.mjs --verify-published",
    "build:candidate": "node scripts/build-candidate-bundle.mjs",
    "publish:release": "node scripts/publish-release.mjs"
  },
  "optionalDependencies": {
    "@opum-ai/quest-darwin-arm64": "0.13.0",
    "@opum-ai/quest-darwin-x64": "0.13.0",
    "@opum-ai/quest-linux-arm64": "0.13.0",
    "@opum-ai/quest-linux-x64": "0.13.0",
    "@opum-ai/quest-win32-arm64": "0.13.0",
    "@opum-ai/quest-win32-x64": "0.13.0"
  },
  "questPlatformPackages": {
    "@opum-ai/quest-darwin-arm64": "59d1c0dc66a499ce372f3af1d5ef01f8d8f9734a0d06539c97d91582ab8c1e60",
    "@opum-ai/quest-darwin-x64": "7682e1345e781bd1a83a76970d36d3f5827a46abf6784d2f142d6317f0f44e69",
    "@opum-ai/quest-linux-arm64": "89cdbeb5631b7a793f6dffe183a588623719863c69ad7d2a91b9fea9918ea76b",
    "@opum-ai/quest-linux-x64": "1609c920eaaf24edb55d13ed593a92e668a1e54ae83d360a4e6b6d858c73e0fd",
    "@opum-ai/quest-win32-arm64": "7e56502b7bbd33047602e722a0dc90e9f107f3ddf2deb00c10d24405163af9f2",
    "@opum-ai/quest-win32-x64": "28954d2f8e684ae09faedb5ebdbcef584149edf57ef98cfd10fa08a46d84a3f7"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "commander": "15.0.0",
    "js-yaml": "5.3.0",
    "string-width": "8.2.2",
    "unicode-case-folding": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
